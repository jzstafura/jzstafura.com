---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MMN from '../../../components/educational/MMN.jsx';
---

<BaseLayout
  title="Mismatch Negativity — JZ Stafura"
  description="An interactive visualization of the MMN — pre-attentive auditory deviance detection. Toggle attended/unattended and frequency/duration/intensity deviants to see the P3a vanish while the MMN persists, isolated in the deviant-minus-standard difference wave."
>
  <div class="full-bleed">
    <MMN client:load />
  </div>
</BaseLayout>

<style>
  :global(main) {
    padding: 0 !important;
    max-width: none !important;
  }
  .full-bleed {
    width: 100%;
  }
</style>
