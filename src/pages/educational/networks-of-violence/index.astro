---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NetworksOfViolence from '../../../components/educational/NetworksOfViolence.jsx';
---

<BaseLayout
  title="Five Handshakes: Networks and the Risk of Gunshot Injury — JZ Stafura"
  description="An interactive reconstruction of Papachristos, Braga & Hureau (2012). Trace the shortest chain of ties between any person and the nearest gunshot victim, watch modelled risk fall about 25% with every step, and compare network position against individual risk factors on the same 220 people."
>
  <div class="full-bleed">
    <NetworksOfViolence client:load />
  </div>

  <nav class="pair-link">
    <span class="pair-label">Follow-up</span>
    <a href="/educational/contagion-or-homophily/">The Confound: Contagion or Homophily? →</a>
  </nav>
</BaseLayout>

<style>
  :global(main) {
    padding: 0 !important;
    max-width: none !important;
  }
  .full-bleed {
    width: 100%;
  }

  .pair-link {
    border-top: 1px solid var(--color-border);
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .pair-label {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.68rem;
    color: var(--color-muted);
  }

  .pair-link a {
    color: var(--color-accent);
  }
</style>
